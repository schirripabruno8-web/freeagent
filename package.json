{
  "name": "freeagent",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop agent that drives free web chats (web-chat bridge)",
  "author": "Btuno",
  "license": "MIT",
  "homepage": "https://github.com/schirripabruno8-web/freeagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schirripabruno8-web/freeagent.git"
  },
  "bugs": {
    "url": "https://github.com/schirripabruno8-web/freeagent/issues"
  },
  "keywords": [
    "electron",
    "ai-agent",
    "mcp",
    "free-llm",
    "deepseek",
    "qwen",
    "windows"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "inspect": "electron-vite build && electron out/main/inspect.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "node scripts/pack.mjs",
    "import:ponytail": "node scripts/import-ponytail.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "local.freeagent",
    "productName": "FreeAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "config/**",
      "skills/**",
      "package.json"
    ],
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
